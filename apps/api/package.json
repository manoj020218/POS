{
  "name": "@smart-pos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:dev": "tsx src/scripts/bootstrap-dev.ts",
    "bootstrap:owner": "tsx src/scripts/bootstrap-owner.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "dev:memory": "tsx watch src/scripts/dev-in-memory-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "razorpay": "^2.9.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5"
  }
