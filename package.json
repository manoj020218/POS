{
  "name": "smart-pos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.8.0"
  },
  "scripts": {
    "bootstrap:dev": "pnpm --filter @smart-pos/api bootstrap:dev",
    "bootstrap:owner": "pnpm --filter @smart-pos/api bootstrap:owner",
    "build": "pnpm --recursive --filter @smart-pos/printer --filter @smart-pos/client-data --filter @smart-pos/api --filter @smart-pos/pos build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "dev": "pnpm --filter @smart-pos/api dev",
    "dev:pos": "pnpm --filter @smart-pos/pos dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --filter @smart-pos/printer --filter @smart-pos/client-data --filter @smart-pos/api --filter @smart-pos/pos typecheck"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
