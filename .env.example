NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_pos
JWT_SECRET=replace-with-at-least-32-characters
REFRESH_SECRET=replace-with-at-least-32-characters
BRIDGE_SHARED_SECRET=replace-with-at-least-32-characters
LOG_LEVEL=info

# Encrypts tenant-owned payment-gateway secrets (Razorpay keys, etc.) at rest.
# 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, businesses can still view/enable payment gateway cards but
# writing new credentials is refused rather than ever stored in plaintext.
# NEVER regenerate this in production once real credentials are saved
# against it — existing encrypted rows become undecryptable.
CREDENTIALS_ENCRYPTION_KEY=

# Where uploaded product images are written on disk, and the public URL
# prefix used to serve them back. Both required for product image uploads
# to work — without PUBLIC_BASE_URL, uploads are refused (503).
UPLOAD_DIR=./uploads/products
PUBLIC_BASE_URL=

# Optional: only needed for password-reset emails. Without these, password
# reset requests are accepted but no email is actually sent.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEV_TENANT_ID=
DEV_TENANT_NAME=
DEV_TENANT_SLUG=
DEV_BUSINESS_CODE=
DEV_BUSINESS_NAME=
DEV_BRANCH_CODE=
DEV_BRANCH_NAME=
DEV_BRANCH_ADDRESS=
DEV_TERMINAL_CODE=
DEV_TERMINAL_NAME=
DEV_TERMINAL_INSTALLATION_ID=
DEV_AUTH_USER_ID=
DEV_AUTH_NAME=
DEV_AUTH_EMAIL=
DEV_AUTH_PASSWORD=
DEV_AUTH_ROLE=
BOOTSTRAP_OWNER_TENANT_ID=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_ROLE=
BOOTSTRAP_OWNER_USER_ID=
